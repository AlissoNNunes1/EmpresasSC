generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum PorteEmpresa {
  MEI
  MICRO
  PEQUENA
  MEDIA
  GRANDE
}

enum SituacaoEmpresa {
  ATIVA
  INATIVA
  SUSPENSA
  ENCERRADA
}

enum TipoResponsavel {
  PROPRIETARIO
  GERENTE
  RH
}

enum PapelUsuario {
  ADMIN
  ANALISTA
  VISUALIZADOR
}

model Usuario {
  id            Int          @id @default(autoincrement())
  nome          String
  email         String       @unique
  senhaHash     String
  papel         PapelUsuario @default(VISUALIZADOR)
  ativo         Boolean      @default(true)
  criadoEm      DateTime     @default(now())
  atualizadoEm  DateTime     @updatedAt
  logs          LogAcesso[]

  @@map("usuarios")
}

model Categoria {
  id          Int       @id @default(autoincrement())
  nome        String    @unique
  ativo       Boolean   @default(true)
  criadoEm    DateTime  @default(now())
  atualizadoEm DateTime @updatedAt
  empresas    Empresa[]
  configuracoesPadrao ConfiguracaoSistema[] @relation("CategoriaPadrao")

  @@map("categorias")
}

model ConfiguracaoSistema {
  id                         Int       @id @default(autoincrement())
  nomeSistema                String    @default("EmpresasSC") @map("nome_sistema")
  nomeMunicipio              String    @default("Sao Cristovao") @map("nome_municipio")
  logoUrl                    String?   @map("logo_url")
  emailInstitucional         String    @default("contato@empresassc.local") @map("email_institucional")
  minEmpregadosPequena       Int       @default(10) @map("min_empregados_pequena")
  maxEmpregadosPequena       Int       @default(49) @map("max_empregados_pequena")
  minEmpregadosMedia         Int       @default(50) @map("min_empregados_media")
  maxEmpregadosMedia         Int       @default(249) @map("max_empregados_media")
  categoriaPadraoId          Int?      @map("categoria_padrao_id")
  politicaSenhaMinCaracteres Int       @default(8) @map("politica_senha_min_caracteres")
  tempoSessaoMinutos         Int       @default(480) @map("tempo_sessao_minutos")
  controleLoginAtivo         Boolean   @default(false) @map("controle_login_ativo")
  integracaoCnpjAtiva        Boolean   @default(false) @map("integracao_cnpj_ativa")
  webhookUrl                 String?   @map("webhook_url")
  criadoEm                   DateTime  @default(now()) @map("criado_em")
  atualizadoEm               DateTime  @updatedAt @map("atualizado_em")

  categoriaPadrao            Categoria? @relation("CategoriaPadrao", fields: [categoriaPadraoId], references: [id], onDelete: SetNull)

  @@index([categoriaPadraoId])
  @@map("configuracoes_sistema")
}

model Empresa {
  id                 Int            @id @default(autoincrement())
  razaoSocial        String         @map("razao_social")
  nomeFantasia       String?        @map("nome_fantasia")
  cnpj               String         @unique
  porte              PorteEmpresa
  categoriaId        Int            @map("categoria_id")
  atividadePrincipal String         @map("atividade_principal")
  numeroEmpregados   Int            @map("numero_empregados")
  situacao           SituacaoEmpresa
  criadoEm           DateTime       @default(now())
  atualizadoEm       DateTime       @updatedAt

  categoria          Categoria      @relation(fields: [categoriaId], references: [id])
  endereco           Endereco?
  responsaveis       Pessoa[]
  camposCustom       ValorCampoEmpresa[]

  @@index([categoriaId])
  @@index([porte])
  @@index([situacao])
  @@map("empresas")
}

model Endereco {
  id         Int      @id @default(autoincrement())
  empresaId  Int      @unique @map("empresa_id")
  cep        String
  bairro     String
  logradouro String

  empresa    Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([bairro])
  @@map("enderecos")
}

model Pessoa {
  id         Int             @id @default(autoincrement())
  empresaId  Int             @map("empresa_id")
  nome       String
  tipo       TipoResponsavel
  cpf        String
  contato    String

  empresa    Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@map("pessoas")
}

// Em SQLite, estas tabelas funcionam como cache de visoes materializadas.
// Em PostgreSQL, podem ser substituidas por MATERIALIZED VIEW de mesmo objetivo.
model ResumoCategoriaView {
  categoria       String   @id
  totalEmpresas   Int      @map("total_empresas")
  totalEmpregados Int      @map("total_empregados")
  atualizadoEm    DateTime @updatedAt @map("atualizado_em")

  @@map("mv_resumo_categoria")
}

model ResumoBairroView {
  bairro          String   @id
  totalEmpresas   Int      @map("total_empresas")
  totalEmpregados Int      @map("total_empregados")
  atualizadoEm    DateTime @updatedAt @map("atualizado_em")

  @@map("mv_resumo_bairro")
}

model ResumoPorteView {
  porte           PorteEmpresa @id
  totalEmpresas   Int          @map("total_empresas")
  totalEmpregados Int          @map("total_empregados")
  atualizadoEm    DateTime     @updatedAt @map("atualizado_em")

  @@map("mv_resumo_porte")
}

model CampoEmpresa {
  id          Int       @id @default(autoincrement())
  nome        String    @unique
  label       String
  tipo        String    @default("TEXTO")
  builtin     Boolean   @default(false)
  obrigatorio Boolean   @default(false)
  visivel     Boolean   @default(true)
  ordem       Int       @default(999)
  opcoes      String?
  criadoEm    DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")
  valores     ValorCampoEmpresa[]

  @@map("campos_empresa")
}

model ValorCampoEmpresa {
  id        Int          @id @default(autoincrement())
  empresaId Int          @map("empresa_id")
  campoId   Int          @map("campo_id")
  valor     String
  empresa   Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  campo     CampoEmpresa @relation(fields: [campoId], references: [id], onDelete: Cascade)

  @@unique([empresaId, campoId])
  @@index([empresaId])
  @@map("valores_campos_empresa")
}

model LogAcesso {
  id         Int      @id @default(autoincrement())
  usuarioId  Int?     @map("usuario_id")
  email      String?
  rota       String
  acao       String
  ip         String?
  userAgent  String?  @map("user_agent")
  criadoEm   DateTime @default(now()) @map("criado_em")

  usuario    Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([usuarioId])
  @@index([rota])
  @@index([criadoEm])
  @@map("logs_acesso")
}
